{
  "layer": "top",
  "position": "top",
  "modules-left": [
    "hyprland/workspaces",
    "custom/media",
    "image#album-art",
    "custom/image"
  ],
  "modules-center": [
    "clock",
  ],
  "modules-right": [
    "pulseaudio",
    "backlight",
    // "power-profiles-daemon",
    "network",
    "cpu",
    "memory",
    "battery",
    "custom/notification",
    "tray",
    "custom/power",
  ],
  "hyprland/workspaces": {
    "format": "{name}: {icon}",
    "format-icons": {
      "active": "❤",
      "default": "◯"
    },
  },
  "hyprland/window": {
    "separate-outputs": true,
  },
  "tray": {
    "icon-size": 15,
    "spacing": 2,
    "icons": {
        "easyeffects": "com.github.wwmm.easyeffects-symbolic",
    }
  },
  "clock": {
    "timezone": "Europe/Stockholm",
    "interval": 1,
    "format": "{:%d/%m • %I:%M:%S}",
    "tooltip-format": "<big><b>{:%A,%d/%m}</b></big>\n\n<tt>{calendar}</tt>",
    "calendar": {
        "weeks-pos": "left",
        "format": {
            "today": "<span color='#ff4040'><b><u>{}</u></b></span>",
            "weeks": "<span color='#99ffdd'><b>W.{}</b></span>",
            "weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
            "months":     "<span><b>{}</b></span>",
		      	"days":       "<span><b>{}</b></span>",
        }
    }
},
  "network": {
    "format-wifi": "󰤢 {bandwidthDownBits}",
    "format-ethernet": "󰈀 {bandwidthDownBits}",
    "format-disconnected": "󰤭 No Network",
    "on-click": "kitty -e impala",
    "interval": 1,
    "tooltip": true,
    "min-length": 12,
    "tooltip-format": "{essid} ({signalStrength}%)",
  },
  "cpu": {
    "interval": 1,
    "on-click": "kitty -e btop",
    "format": "{icon} {usage}%",
    "format-icons": [
      "▁",
      "▂",
      "▃",
      "▄",
      "▅",
      "▆",
      "▇",
      "█"
    ],
  },
  "memory": {
    "interval": 1,
    "format": " {used:0.01f}G",
    "on-click": "kitty -e btop",
  },
  "backlight": {
    "interval": 1,
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
    "min-length": 6,
  },
  "pulseaudio": {
    "interval": 1,
    "format": "{icon} {volume}%",
    "format-muted": " {volume}%",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ],
    },
    "on-click": "pavucontrol",
    "min-length": 7,
  },
  "battery": {
    "interval": 3,
    "states": {
      "warning": 30,
      "critical": 10,
    },
    "tooltip": true,
    "tooltip-format": "{time}",
    "format": "{icon} {capacity: >3}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-full": " {capacity}%",
    "format-alt": "{time}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile:{profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": "",
    },
    "on-click-right": "tuned-gui",
  },
  "custom/power": {
    "tooltip": false,
    "on-click": "~/.config/rofi/powermenu/type-2/powermenu.sh",
    "format": " ⏻ ",
  },
  "custom/notification": {
    "tooltip": true,
    "format": "<span size='10pt'>{icon}</span>",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },
  "custom/media": {
    "exec": "~/.config/waybar/playerctl.sh",
    "return-type": "text",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    "max-length": 25,
  },
  "custom/image":{
    "format": "",
    "exec": "~/.config/hypr/scripts/spotify_hlock.sh",
    "interval": 1,
  },
  "image#album-art": {
    "path": "/tmp/spotify_cover.jpg",
    "size": 30,
    "interval": 1,
    "on-click": "~/.config/hypr/scripts/spotify_hlock.sh"
  },
  
}
